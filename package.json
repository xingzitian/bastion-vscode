      },
      {
        "command": "bastion.sendTailToAI",
        "key": "ctrl+alt+shift+i",
        "mac": "cmd+alt+shift+i",
        "when": "terminalFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bastion.addProfile",
          "when": "view == bastion.profiles",
          "group": "navigation@1"
        },
        {
          "command": "bastion.refreshProfiles",
          "when": "view == bastion.profiles",
          "group": "navigation@2"
        },
        {
          "command": "bastion.openProfilesFile",
          "when": "view == bastion.profiles",
          "group": "navigation@3"
        },
        {
          "command": "bastion.addDeployTask",
          "when": "view == bastion.deployTasks",
          "group": "navigation@1"
        },
        {
          "command": "bastion.batchRunDeployTasks",
          "when": "view == bastion.deployTasks",
          "group": "navigation@2"
        },
        {
          "command": "bastion.exportDeployTasks",
          "when": "view == bastion.deployTasks",
          "group": "navigation@3"
        },
        {
          "command": "bastion.openLastDeployReport",
          "when": "view == bastion.deployTasks",
          "group": "navigation@4"
        },
        {
          "command": "bastion.toggleKeepDeployTerminal",
          "when": "view == bastion.deployTasks",
          "group": "navigation@5"
        },
        {
          "command": "bastion.addQuickCommand",
          "when": "view == bastion.quickCommands",
          "group": "navigation@1"
        },
        {
          "command": "bastion.openQuickCommandsFile",
          "when": "view == bastion.quickCommands",
          "group": "navigation@2"
        },
        {
          "command": "bastion.addForwardRule",
          "when": "view == bastion.forwards",
          "group": "navigation@1"
        },
        {
          "command": "bastion.openForwardsFile",
          "when": "view == bastion.forwards",
          "group": "navigation@2"
        },
        {
          "command": "bastion.stopAllForwards",
          "when": "view == bastion.forwards",
          "group": "navigation@3"
        },
        {
          "command": "bastion.openHabitsFile",
          "when": "view == bastion.profiles",
          "group": "navigation@4"
        },
        {
          "command": "bastion.openDangerRulesFile",
          "when": "view == bastion.profiles",
          "group": "navigation@5"
