          "group": "inline@0"
        },
        {
          "command": "bastion.sendQuickCommand",
          "when": "view == bastion.quickCommands && viewItem == quickCommand",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.openQuickCommandsFile",
          "when": "view == bastion.quickCommands && viewItem == quickCommand",
          "group": "2_编辑@1"
        },
        {
          "command": "bastion.deleteQuickCommand",
          "when": "view == bastion.quickCommands && viewItem == quickCommand",
          "group": "3_删除@1"
        },
        {
          "command": "bastion.startForward",
          "when": "view == bastion.forwards && viewItem == forwardIdle",
          "group": "inline@0"
        },
        {
          "command": "bastion.stopForward",
          "when": "view == bastion.forwards && viewItem == forwardActive",
          "group": "inline@0"
        },
        {
          "command": "bastion.startForward",
          "when": "view == bastion.forwards && viewItem == forwardIdle",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.stopForward",
          "when": "view == bastion.forwards && viewItem == forwardActive",
