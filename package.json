{
  "name": "bastion-vscode",
  "displayName": "BastionShell SSH",
  "description": "SSH 堡垒机终端：一次 MFA + 连接复用，多开会话/批量部署/rz/sz 文件传输/端口转发/快捷命令，并提供 bastion.exec 让 VS Code 里的 AI 插件在服务器上执行命令",
  "version": "0.1.5",
  "publisher": "xingzitian",
  "author": "杏子甜",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingzitian/bastion-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/xingzitian/bastion-vscode/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f141b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "ssh-client",
    "sftp",
    "terminal",
    "bastion",
    "jump-server",
    "jump-host",
    "remote",
    "devops",
    "tunnel",
    "port-forwarding",
    "zmodem",
    "rz",
    "sz",
    "mfa",
    "otp",
    "session",
    "堡垒机",
    "跳板机",
    "远程终端",
    "运维",
    "端口转发",
    "jumpserver",
    "jumpbox",
    "connection-reuse",
    "batch-deploy",
    "file-transfer",
    "批量部署",
    "会话复用"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:bastion.connect",
    "onCommand:bastion.uploadToSession",
    "onCommand:bastion.addProfile",
    "onCommand:bastion.connectProfile",
    "onCommand:bastion.deleteProfile",
    "onCommand:bastion.refreshProfiles",
    "onCommand:bastion.addDeployTask",
    "onCommand:bastion.runDeployTask",
    "onCommand:bastion.stopDeployTask",
    "onCommand:bastion.openLastDeployReport",
    "onCommand:bastion.deleteDeployTask",
    "onCommand:bastion.addFileToDeployTask",
    "onCommand:bastion.batchRunDeployTasks",
    "onCommand:bastion.batchConnect",
    "onCommand:bastion.openDeployTask",
    "onCommand:bastion.exportDeployTasks",
    "onCommand:bastion.exec",
    "onCommand:bastion.reconnect",
    "onCommand:bastion.addQuickCommand",
    "onCommand:bastion.sendQuickCommand",
    "onCommand:bastion.deleteQuickCommand",
    "onCommand:bastion.addForwardRule",
    "onCommand:bastion.startForward",
    "onCommand:bastion.stopForward",
    "onCommand:bastion.deleteForwardRule",
    "onCommand:bastion.openHabitsFile",
    "onCommand:bastion.openDangerRulesFile",
    "onCommand:bastion.sendSelectionToAI",
    "onCommand:bastion.sendTailToAI",
    "onCommand:bastion.pickSession",
    "onCommand:bastion.toggleReadOnly",
    "onCommand:bastion.toggleKeepDeployTerminal",
    "onCommand:bastion.pickOverwriteMode",
    "onCommand:bastion.stopAllForwards",
    "onCommand:bastion.showForwards",
    "onCommand:bastion.showTransferHistory",
    "onCommand:bastion.retryTransfer",
    "onCommand:bastion.clearTransferHistory",
    "onCommand:bastion.revealTransferItem",
    "onCommand:bastion.copyTransferPath",
    "onCommand:bastion.showOverview",
    "onView:bastion.overview",
    "onView:bastion.transfers",
    "onLanguageModelTool:bastion_exec",
    "onLanguageModelTool:bastion_connect",
    "onLanguageModelTool:bastion_listSessions",
    "onLanguageModelTool:bastion_listProfiles",
    "onLanguageModelTool:bastion_habits",
    "onCommand:bastion.showLog",
    "onCommand:bastion.openProfilesFile",
    "onCommand:bastion.openForwardsFile",
    "onCommand:bastion.openQuickCommandsFile",
    "onCommand:bastion.openTransferHistoryFile",
    "onView:bastion.profiles",
    "onView:bastion.deployTasks",
    "onView:bastion.quickCommands",
    "onView:bastion.forwards"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "**/tasks/*.json",
        "url": "./schemas/deploy-task.schema.json"
      },
      {
        "fileMatch": "**/tasks/*.jsonc",
        "url": "./schemas/deploy-task.schema.json"
      }
    ],
    "configuration": {
      "title": "BastionShell",
      "properties": {
        "bastion.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "editor",
          "description": "新会话的显示位置：editor = 编辑器区域（和文件标签一样，可拖拽分屏），panel = 底部面板"
        },
        "bastion.sendToAiMode": {
          "type": "string",
          "enum": [
            "insert",
            "send"
          ],
          "default": "insert",
          "description": "「把终端选中内容/最近输出发给 AI」的行为：insert = 只把内容填进 AI 聊天输入框，你可以再补一句话再回车（推荐）；send = 直接发出去"
        },
        "bastion.tailLines": {
          "type": "number",
          "default": 80,
          "description": "「把终端最近输出发给 AI」时带多少行（1-1000）"
        },
        "bastion.verboseLog": {
          "type": "boolean",
          "default": false,
          "description": "打开详细日志（ZMODEM 握手帧原始字节等诊断信息）。平时关着，免得把真正有用的日志行挤掉。排查文件传输问题时再打开。"
        },
        "bastion.passwordPromptPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "**密码提示**的识别关键词（子串匹配，不区分大小写）。留空用内置默认；**填了就整套替换**。\n\n用途：决定一个交互提示是在问密码、还是在问 MFA 动态码 —— 判错会把动态码当密码填进去（或反过来）。\n\n内置默认：`password`、`passphrase`、`passwd`、`密码`、`密碼`、`口令`、`パスワード`、`암호`。\n\n换一家文案不同的堡垒机时，把你家实际那串提示词填进来即可。\n\n> 高危命令的规则不在这里，在 `~/.bastionshell/dangerRules.jsonc`（用命令「打开高危命令规则文件」）。菜单提示在 `bastion.menuHints.*`。"
        },
        "bastion.sessionNumber": {
          "type": "boolean",
          "default": true,
          "description": "终端名前面加会话号（#1、#2…），便于区分多个会话，也让 AI 用 bastion_exec 的 terminal 参数精确指定目标（关掉后终端名就只有 用户@主机）"
        },
        "bastion.menuHints.hostPromptLoose": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "主菜单的**弱特征**：只有提示符本身。留空用内置默认（`Opt>`、`[Host]>`）；填了整套替换。\n\n⚠️ 它**只用于第一次等主菜单**，不参与「IP 被拒绝、菜单又回到输 IP」的判断 —— 因为输完 IP 后那行回显是 `Opt> Opt> 10.0.0.10`，堡垒机只要重画一次提示符就会被误判成「IP 被拒绝」。\n\n你家的提示符如果不是 `Opt>` / `[Host]>`，填这里。不确定就先留空：认不出来时日志会把屏幕原文打出来。"
        },
        "bastion.menuHints.hostPrompt": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "堡垒机**主菜单**（提示你输目标机 IP / 资产编号）的识别正则 —— 只放**菜单正文的措辞**，不要放裸提示符（那属于 `bastion.menuHints.hostPromptLoose`）。留空用内置默认；**填了就整组替换内置**。\n\n内置含实测过的某厂商堡垒机 写法（`进行搜索`、`输入 部分IP，主机名…`）和 JumpServer / 齐治常见写法。\n\n识别不到会自动退回固定等待（不会更差），并把当时屏幕原文打进日志 —— 照着它补一条即可。"
        },
        "bastion.menuHints.userPrompt": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "堡垒机**二级菜单**（提示你选登录用户）的识别正则。留空用内置默认；填了整组替换。"
        },
        "bastion.menuHints.shellPrompt": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "目标机 **shell 提示符**的识别正则（判断是否已经落到目标机）。留空用内置默认；填了整组替换。"
        },
        "bastion.deployTerminalPolicy": {
          "type": "string",
          "enum": [
            "closeSuccess",
            "ask",
            "keep",
            "closeAll"
          ],
          "enumDescriptions": [
            "成功的会话自动关掉，失败的留着（默认。失败终端里有出错现场，关掉就等于销毁证据）",
            "跑完弹一次问你要不要保留窗口 —— 报告里虽然记了每条命令的输出，但有人就是想自己去翻",
            "全部保留，和以前一样（长时间批量部署会堆很多终端）",
            "全部关掉，包括失败的"
          ],
          "default": "closeSuccess",
          "description": "批量部署结束后，怎么处理为每台机器开的会话终端"
        },
        "bastion.uploadOverwrite": {
          "type": "string",
          "enum": [
            "skip",
            "overwrite",
            "rename"
          ],
          "enumDescriptions": [
            "远端已有同名文件就跳过不传（默认，最安全）",
            "直接覆盖远端同名文件（rz -y）",
            "远端自动改名保留旧文件（rz -E），新文件叫 xxx.0 之类"
          ],
          "default": "skip",
          "description": "上传（rz）时遇到远端同名文件的处理方式。下载（sz）的落盘位置仍由每次的目录选择决定。"
        }
      }
    },
