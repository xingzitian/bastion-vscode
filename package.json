        {
          "command": "bastion.toggleReadOnly",
          "when": "terminalFocus",
          "group": "0_bastion@0"
        },
        {
          "command": "bastion.sendSelectionToAI",
          "when": "terminalFocus",
          "group": "0_bastion@1"
        },
        {
          "command": "bastion.sendTailToAI",
          "when": "terminalFocus",
          "group": "0_bastion@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bastion.connectProfile",
          "when": "view == bastion.profiles && viewItem == profile",
          "group": "inline@0"
        },
        {
          "command": "bastion.connectProfile",
          "when": "view == bastion.profiles && viewItem == profile",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.openProfilesFile",
          "when": "view == bastion.profiles && viewItem == profile",
          "group": "2_编辑@1"
        },
        {
          "command": "bastion.deleteProfile",
          "when": "view == bastion.profiles && viewItem == profile",
          "group": "3_删除@1"
        },
        {
          "command": "bastion.runDeployTask",
          "when": "view == bastion.deployTasks && viewItem == deployTask",
          "group": "inline@0"
        },
        {
          "command": "bastion.stopDeployTask",
          "when": "view == bastion.deployTasks && viewItem == deployTaskRunning",
          "group": "inline@0"
        },
        {
          "command": "bastion.runDeployTask",
          "when": "view == bastion.deployTasks && viewItem == deployTask",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.stopDeployTask",
          "when": "view == bastion.deployTasks && viewItem == deployTaskRunning",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.openDeployTask",
          "when": "view == bastion.deployTasks && viewItem =~ /deployTask/",
          "group": "2_编辑@1"
        },
        {
          "command": "bastion.deleteDeployTask",
          "when": "view == bastion.deployTasks && viewItem == deployTask",
          "group": "3_删除@1"
        },
        {
          "command": "bastion.sendQuickCommand",
          "when": "view == bastion.quickCommands && viewItem == quickCommand",
          "group": "inline@0"
        },
        {
          "command": "bastion.sendQuickCommand",
          "when": "view == bastion.quickCommands && viewItem == quickCommand",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.openQuickCommandsFile",
          "when": "view == bastion.quickCommands && viewItem == quickCommand",
          "group": "2_编辑@1"
        },
        {
          "command": "bastion.deleteQuickCommand",
          "when": "view == bastion.quickCommands && viewItem == quickCommand",
          "group": "3_删除@1"
        },
        {
          "command": "bastion.startForward",
          "when": "view == bastion.forwards && viewItem == forwardIdle",
          "group": "inline@0"
        },
        {
          "command": "bastion.stopForward",
          "when": "view == bastion.forwards && viewItem == forwardActive",
          "group": "inline@0"
        },
        {
          "command": "bastion.startForward",
          "when": "view == bastion.forwards && viewItem == forwardIdle",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.stopForward",
          "when": "view == bastion.forwards && viewItem == forwardActive",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.openForwardsFile",
          "when": "view == bastion.forwards && viewItem =~ /forward/",
          "group": "2_编辑@1"
        },
        {
          "command": "bastion.deleteForwardRule",
          "when": "view == bastion.forwards && viewItem =~ /forward/",
          "group": "3_删除@1"
        },
        {
          "command": "bastion.retryTransfer",
          "when": "view == bastion.transfers && viewItem == transferFailed",
          "group": "inline@0"
        },
        {
          "command": "bastion.retryTransfer",
          "when": "view == bastion.transfers && viewItem == transferFailed",
          "group": "1_主操作@1"
        },
        {
          "command": "bastion.revealTransferItem",
          "when": "view == bastion.transfers && viewItem =~ /transfer/",
          "group": "2_操作@1"
        },
        {
          "command": "bastion.copyTransferPath",
          "when": "view == bastion.transfers && viewItem =~ /transfer/",
          "group": "2_操作@2"
        }
      ],
      "explorer/context": [
        {
          "command": "bastion.uploadToSession",
          "when": "!explorerResourceIsFolder && bastion.hasSession && bastion.activeIsBastion",
          "group": "7_modification"
        },
        {
          "command": "bastion.rsyncSyncToSession",
          "when": "bastion.hasSession && config.bastion.rsyncEnabled",
          "group": "7_modification"
        },
        {
          "command": "bastion.addFileToDeployTask",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    }
