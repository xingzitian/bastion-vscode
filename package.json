  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/test/*.test.js\"",
    "test:only": "node --test \"out/test/*.test.js\"",
    "package": "tsc -p ./ && npx --yes @vscode/vsce package --allow-missing-repository"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "ssh2": "^1.17.0",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  }
}
